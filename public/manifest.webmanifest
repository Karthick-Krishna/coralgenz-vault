{
  "name": "Coralgenz Vault",
  "short_name": "Vault",
  "description": "Enterprise-Grade High-Security Cryptographic File Protection System with Zero-Knowledge AES-256 Encryption.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#05070A",
  "theme_color": "#05070A",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Coralgenz Secure File",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/x-secure-container": [".secure"],
        "text/html": [".secure.html"]
      }
    }
  ]
}
